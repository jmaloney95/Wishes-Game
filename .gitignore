# Third-party trees that don't belong in project history.
# All of these are large and re-downloadable from their own sources; the
# setup steps live in Toolchain_and_Setup_Guide.md.
nds-src/
Tools/
mGBA-0.10.5-win32/

# Local scratch and generated files.
__pycache__/
*.pyc
*.backup.xlsx

# OS cruft.
.DS_Store
Thumbs.db

# Never publish a built ROM. The site distributes a patch; players bring
# their own base ROM. A stray .gba under docs/ would go out with Pages.
docs/**/*.gba
docs/_test/
