@!game(BPRE0)

@data.battle.customBg.variable(2) 07 50

@data.battle.customBg.hook1(30)
.thumb
    lsl   r5, r0, #24
    lsr   r5, r5, #24
    lsl   r6, r0, #0
    ldr   r0, var
	ldrh  r0, [r0]
    ldr   r3, =0x0806E569 @VarGet
	bl    linker
	cmp   r0, #0
	beq   back
    pop   {r1-r2, r4-r6, pc}
back:
    ldr   r3, =0x08059F35
	ldr   r0, =0x0944F671 @back after hook
	bx    r0
linker: bx r3
var: .word <data.battle.customBg.variable>
.end

@0944F668 00 4D 28 47 <data.battle.customBg.hook1+1>

@data.battle.customBg.hook2(30)
.thumb
	push  {r0-r3}
    ldr   r0, var
	ldrh  r0, [r0]
    ldr   r3, =0x0806E569 @VarGet
	bl    linker
	cmp   r0, #0
	beq   back
    pop   {r0-r3}
    ldr   r3, =0x0944F77F @back after hook
linker:
	bx    r3
back:
    pop   {r0-r3}
    lsl   r3, r2, #28
    bpl   back2
    ldr   r3, =0x020386AE
    ldrh  r0, [r3, #0]
    ldr   r3, =0x0946E3A9
	bl    linker
back2:
    ldr   r4, =0x0944F7A5
	bx    r4
var: .word <data.battle.customBg.variable>
.end

@0944F774 00 4B 18 47 <data.battle.customBg.hook2+1>

@data.battle.customBg.variable ^data.battle.customBg.variable[var:|h]1
